    #2 getheaders = GetHeadersMessage(start_block=previous.hash(),end_block= bytes.fromhex('000000009b7262315dbf071787ad3656097b892abffd1f95a1a022f896f533fc'))
    getheaders = GetHeadersMessage(start_block=bytes.fromhex('0000000082b5015589a3fdf2d4baff403e6f0be035a5d9742c1cae6295464449')\
                                   ,end_block= bytes.fromhex('000000009b7262315dbf071787ad3656097b892abffd1f95a1a022f896f533fc')) # block3 and block5
    #which is going to give the headers from block 4 to block 5 , ie, headers.blocks[0] is block 4, headers.blocks[1] is block 5
    
    node.send(getheaders)
